{
  "name": "evrcalc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "周刊虚拟歌手中文曲排行榜 · 视频得分计算器",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "server:build": "node scripts/build-server.mjs linux-amd64",
    "server:build:all": "node scripts/build-server.mjs all",
    "server:verify": "node scripts/verify-elf.mjs",
    "server:test": "node scripts/run-go-test.mjs",
    "server:check": "node scripts/verify-server.mjs",
    "port:check": "node scripts/check-port.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
